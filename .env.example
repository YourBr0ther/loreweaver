# Loreweaver Environment Configuration

# Anthropic API Key (required for AI extraction)
# Get one at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional: Specify Claude model (default: claude-sonnet-4)
# ANTHROPIC_MODEL=claude-sonnet-4

# Optional: Database path (default: ./data/loreweaver.db)
# DATABASE_PATH=./data/loreweaver.db

# Optional: Input directory for session notes (default: ./input)
# INPUT_PATH=./input
